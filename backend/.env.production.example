# ============================================================
# BACKEND — Biến môi trường PRODUCTION (mẫu)
# Copy thành `.env` ở môi trường chạy thật rồi điền giá trị THẬT.
# KHÔNG commit file .env thật (đã .gitignore). KHÔNG để secret demo lên production.
# ============================================================

# --- Cơ bản ---
NODE_ENV=production
PORT=3001
# URL frontend (CORS / liên kết) — đặt domain thật, có https.
FRONTEND_URL=https://thi.dau.edu.vn

# --- Cơ sở dữ liệu (Postgres THẬT) ---
# Dùng tài khoản riêng cho app, mật khẩu mạnh; bật SSL nếu DB ở xa.
DATABASE_URL=postgresql://dau_app:CHANGE_ME@db-host:5432/dau_exam?schema=public

# --- JWT (BẮT BUỘC đổi — KHÔNG dùng giá trị demo) ---
# Sinh chuỗi ngẫu nhiên mạnh, vd: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_strong_random_secret
JWT_REFRESH_SECRET=CHANGE_ME_another_strong_random_secret
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# --- Nguồn câu hỏi / đề (KT&ĐBCL exam-core) ---
# mock = fixture nội bộ (demo). exam-core = lấy đề/đáp án THẬT (cần token).
EXAM_SOURCE=exam-core
EXAM_CORE_BASE_URL=https://dau-api-dev.coregenaihub.com
# Bearer token có scope EXAM_QUALITY_* (lấy từ team exam-core / service account).
EXAM_CORE_TOKEN=CHANGE_ME_exam_core_bearer_token
# (tuỳ chọn) Ngân hàng mặc định khi đề chưa gắn bank/matrix.
EXAM_CORE_BANK_ID=

# --- Đăng nhập (auth) ---
# dev = dev-login giả lập. partner = gọi API đăng nhập THẬT của trường.
AUTH_SOURCE=partner
AUTH_PARTNER_BASE=https://dau-api-dev.coregenaihub.com
DAU_API_BASE_URL=https://dau-api-dev.coregenaihub.com

# --- Bảo mật phòng thi (tuỳ chọn) ---
# Giới hạn dải IP máy phòng lab được phép vào thi (CIDR, phẩy ngăn cách).
# Để TRỐNG = không giới hạn IP.
ALLOWED_IP_RANGES=

# --- Đường dẫn fixture mock (chỉ dùng khi EXAM_SOURCE=mock) ---
# Production dùng exam-core nên thường KHÔNG cần; để mặc định.
# MOCK_API_PATH=/app/mock-api/questions.json
# MOCK_EXAM_DEF_PATH=/app/mock-api/exam-definition.json
