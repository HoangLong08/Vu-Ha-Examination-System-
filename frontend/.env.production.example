# ============================================================
# FRONTEND — Biến môi trường PRODUCTION (mẫu)
# Copy thành `.env.production` (hoặc đặt ở môi trường build/deploy).
# Biến NEXT_PUBLIC_* được nhúng vào bundle lúc BUILD -> phải set trước khi build.
# ============================================================

# URL gốc của Backend API (KHÔNG kèm /api/v1 — code tự thêm).
# Phải là domain thật + https mà trình duyệt người dùng truy cập được.
NEXT_PUBLIC_API_URL=https://api.thi.dau.edu.vn
